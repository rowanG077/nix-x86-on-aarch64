+// SPDX-License-Identifier: MIT
+use std::ffi::{CStr, CString};
+use std::fs;
+use std::io;
+use std::path::PathBuf;
+use std::time::Duration;
+
+use nix::libc;
+use rustix::process::{pidfd_open, pidfd_send_signal, Pid, PidfdFlags, Signal};
+use uuid::Uuid;
+
+use super::user;
+
+const ROOT: &CStr = c"/sys/fs/cgroup/muvm-requests";
+
+/// Kernel-owned membership for one interactive request, independent of its PGID.
+pub struct RequestCgroup {
+    path: PathBuf,
+    name: CString,
+    procs: CString,
+    kill: CString,
+}
+
+// Only async-signal-safe syscalls may run in these post-fork root helpers.
+// Construct paths and buffers in the parent; never allocate or log in the child.
+fn as_root(action: impl FnOnce() -> i32) -> io::Result<()> {
+    let errno = unsafe { user::run_as_root(action) }.map_err(io::Error::other)?;
+    if errno == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::from_raw_os_error(errno))
+    }
+}
+
+unsafe fn write_control(path: &CStr, value: &[u8]) -> i32 {
+    let fd = libc::open(path.as_ptr(), libc::O_WRONLY | libc::O_CLOEXEC);
+    if fd < 0 {
+        return *libc::__errno_location();
+    }
+    let errno = loop {
+        let count = libc::write(fd, value.as_ptr().cast(), value.len());
+        if count == value.len() as isize {
+            break 0;
+        }
+        let errno = if count < 0 {
+            *libc::__errno_location()
+        } else {
+            libc::EIO
+        };
+        if errno != libc::EINTR {
+            break errno;
+        }
+    };
+    libc::close(fd);
+    errno
+}
+
+impl RequestCgroup {
+    pub fn create() -> io::Result<Self> {
+        let path = PathBuf::from(ROOT.to_str().unwrap()).join(Uuid::now_v7().to_string());
+        let name = CString::new(path.as_os_str().as_encoded_bytes()).unwrap();
+        let procs = CString::new(path.join("cgroup.procs").as_os_str().as_encoded_bytes()).unwrap();
+        let kill = CString::new(path.join("cgroup.kill").as_os_str().as_encoded_bytes()).unwrap();
+        as_root(|| unsafe {
+            // This helper exits immediately; the worker's umask is unchanged.
+            // Its unprivileged watcher must be able to read cgroup.events/procs.
+            libc::umask(0o022);
+            if libc::mkdir(ROOT.as_ptr(), 0o755) != 0 && *libc::__errno_location() != libc::EEXIST {
+                return *libc::__errno_location();
+            }
+            if libc::mkdir(name.as_ptr(), 0o755) != 0 {
+                return *libc::__errno_location();
+            }
+            // Fail the launch before exec if this kernel cannot kill cgroups.
+            let fd = libc::open(kill.as_ptr(), libc::O_WRONLY | libc::O_CLOEXEC);
+            if fd < 0 {
+                let errno = *libc::__errno_location();
+                libc::rmdir(name.as_ptr());
+                return errno;
+            }
+            libc::close(fd);
+            0
+        })?;
+        Ok(Self {
+            path,
+            name,
+            procs,
+            kill,
+        })
+    }
+
+    pub fn procs_path(&self) -> CString {
+        self.procs.clone()
+    }
+
+    /// Called only in Command::pre_exec, while the worker's saved root UID exists.
+    pub unsafe fn enter(procs: &CStr) -> io::Result<()> {
+        let uid = libc::geteuid();
+        if libc::seteuid(0) != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let errno = write_control(procs, b"0");
+        if libc::seteuid(uid) != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        if errno == 0 {
+            Ok(())
+        } else {
+            Err(io::Error::from_raw_os_error(errno))
+        }
+    }
+
+    fn signal_members(&self) -> io::Result<()> {
+        let membership = format!(
+            "0::/{}",
+            self.path.strip_prefix("/sys/fs/cgroup").unwrap().display()
+        );
+        for line in fs::read_to_string(self.path.join("cgroup.procs"))?.lines() {
+            let Some(pid) = line.parse::<i32>().ok().and_then(Pid::from_raw) else {
+                continue;
+            };
+            let Ok(fd) = pidfd_open(pid, PidfdFlags::empty()) else {
+                continue;
+            };
+            // Pin the process BEFORE checking membership. A recycled PID must
+            // never turn a graceful signal into a signal to another request.
+            let current = fs::read_to_string(format!("/proc/{line}/cgroup"));
+            if current.is_ok_and(|value| value.lines().any(|line| line == membership)) {
+                let _ = pidfd_send_signal(fd, Signal::Term);
+            }
+        }
+        Ok(())
+    }
+
+    pub async fn terminate(&self) -> io::Result<()> {
+        // The application enters this root-owned cgroup in pre_exec, BEFORE
+        // it can fork. Every descendant inherits membership, including double
+        // forks, setsid(), job-control groups, and orphans whose parent exited.
+        // Apps cannot write the migration files. The cgroup, not a PID/PGID or
+        // a /proc ancestry snapshot, is therefore the lifetime boundary.
+        //
+        // SIGTERM is only a best-effort grace pass over pidfds. Correctness
+        // comes from cgroup.kill: the kernel kills the entire subtree and
+        // serializes against concurrent forks/migrations. Thus children born
+        // during the grace period cannot escape the final SIGKILL, and other
+        // requests are never included, even if the original PID was recycled.
+        // See https://docs.kernel.org/admin-guide/cgroup-v2.html (cgroup.kill).
+        if let Err(err) = self.signal_members() {
+            log::warn!("Could not send graceful request termination: {err}");
+        }
+        tokio::time::sleep(Duration::from_millis(500)).await;
+        as_root(|| unsafe { write_control(&self.kill, b"1") })
+    }
+
+    pub async fn remove_when_empty(self) -> io::Result<()> {
+        // A successful command may deliberately leave a daemon with closed
+        // stdio. Keep its cgroup until it exits, without delaying CMD_EXIT or
+        // cancelling it after the client acknowledged normal completion.
+        while fs::read_to_string(self.path.join("cgroup.events"))?
+            .lines()
+            .any(|line| line == "populated 1")
+        {
+            tokio::time::sleep(Duration::from_millis(50)).await;
+        }
+        self.remove()
+    }
+
+    pub fn remove(self) -> io::Result<()> {
+        as_root(|| unsafe {
+            if libc::rmdir(self.name.as_ptr()) == 0 {
+                0
+            } else {
+                *libc::__errno_location()
+            }
+        })
+    }
+}
