+async fn wait_for_child(
+    mut child: Child,
+    stop_pipe: Option<OwnedFd>,
+    lifetime: Option<(RequestCgroup, BufStream<UnixStream>, oneshot::Receiver<()>)>,
+) -> ChildResult {
+    let Some((cgroup, mut lifetime, io_done)) = lifetime else {
+        return child.wait().await;
+    };
+    let result = {
+        let complete = async {
+            // Reaping the leader is safe: descendants stay in the request's
+            // cgroup, so cleanup never depends on retaining or reusing its PID.
+            let status = child.wait().await?;
+            let code = status
+                .code()
+                .unwrap_or_else(|| 128 + status.signal().unwrap_or(0)) as u8;
+            File::from(stop_pipe.unwrap()).write_all(&[code])?;
+            io_done.await.map_err(io::Error::other)?;
+            Ok::<_, io::Error>(status)
+        };
+        let acknowledged = async {
+            let mut byte = [0];
+            lifetime.read_exact(&mut byte).await?;
+            if byte != [1] {
+                return Err(io::Error::other("invalid completion acknowledgement"));
+            }
+            Ok::<_, io::Error>(())
+        };
+        // Drain output AND receive the client's CMD_EXIT acknowledgement.
+        // Merely finishing I/O is not proof of a normal client exit: it can
+        // race with disconnect. try_join cancels this wait immediately on EOF,
+        // independently of blocked stdin/stdout and of the leader's status.
+        tokio::try_join!(complete, acknowledged).map(|(status, ())| status)
+    };
+    let status = match result {
+        Ok(status) => Ok(status),
+        Err(_) => {
+            cgroup.terminate().await?;
+            child.wait().await
+        },
+    };
+    cgroup.remove_when_empty().await?;
+    status
 }
 
