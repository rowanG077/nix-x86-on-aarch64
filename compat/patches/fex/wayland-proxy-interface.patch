@@ -519,3 +519,18 @@
 }
 
+uintptr_t fexfn_impl_libwayland_client_fex_wl_get_guest_interface(wl_proxy* proxy) {
+  const auto* native = get_proxy_interface(proxy);
+  for (const auto& [guest, host] : guest_to_host_interface) {
+    if (host == native) return reinterpret_cast<uintptr_t>(guest);
+  }
+#ifndef IS_32BIT_THUNK
+  // Custom 64-bit interfaces are passed through without repacking.
+  return reinterpret_cast<uintptr_t>(native);
+#else
+  // Every i386 interface used to create a proxy passes through the registry.
+  fprintf(stderr, "Wayland proxy has no registered guest interface\n");
+  std::abort();
+#endif
+}
+
