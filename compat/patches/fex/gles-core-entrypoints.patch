+// A guest array of string pointers needs element-wise widening on i386.
+static std::vector<const char*> HostVaryings(GLsizei count, guest_layout<const char* const*> varyings) {
+  std::vector<const char*> result;
+  if (varyings.data && count > 0) {
+    result.reserve(count);
+    for (GLsizei i = 0; i < count; ++i) {
+      result.push_back(host_layout<const char* const> {varyings.get_pointer()[i]}.data);
+    }
+  }
+  return result;
+}
