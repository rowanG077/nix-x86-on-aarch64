 #include "thunkgen_host_libEGL.inl"
 
+#ifdef IS_32BIT_THUNK
+using GuestEGLAttrib = int32_t;
+#else
+using GuestEGLAttrib = EGLAttrib;
+#endif
+
+// The generator repacks individual pointees, not variable-length arrays.
+// EGLConfig pointers and EGLAttrib values have different sizes on i386.
+static std::vector<EGLAttrib> HostAttributes(guest_layout<const GuestEGLAttrib*> attributes) {
+  std::vector<EGLAttrib> result;
+  if (auto* value = attributes.get_pointer()) {
+    while (value->data != EGL_NONE) {
+      result.push_back(value++->data);
+      result.push_back(value++->data);
+    }
+    result.push_back(EGL_NONE);
+  }
+  return result;
+}
+
+static void CopyConfigs(guest_layout<EGLConfig*> guest, const std::vector<EGLConfig>& host, EGLint count) {
+  for (int i = 0; i < std::min(count, static_cast<EGLint>(host.size())); ++i) {
+    guest.get_pointer()[i] = to_guest(to_host_layout(host[i]));
+  }
+}
+
+EGLBoolean fexfn_impl_libEGL_eglChooseConfig(EGLDisplay display, const EGLint* attributes,
+                                           guest_layout<EGLConfig*> configs, EGLint capacity, EGLint* count) {
+  std::vector<EGLConfig> native(configs.data ? std::max(capacity, 1) : 0);
+  auto result = fexldr_ptr_libEGL_eglChooseConfig(display, attributes, configs.data ? native.data() : nullptr, capacity, count);
+  if (result && configs.data) {
+    CopyConfigs(configs, native, *count);
+  }
+  return result;
+}
+
+EGLBoolean fexfn_impl_libEGL_eglGetConfigs(EGLDisplay display, guest_layout<EGLConfig*> configs,
+                                         EGLint capacity, EGLint* count) {
+  std::vector<EGLConfig> native(configs.data ? std::max(capacity, 1) : 0);
+  auto result = fexldr_ptr_libEGL_eglGetConfigs(display, configs.data ? native.data() : nullptr, capacity, count);
+  if (result && configs.data) {
+    CopyConfigs(configs, native, *count);
+  }
+  return result;
+}
+
+EGLSync fexfn_impl_libEGL_eglCreateSync(EGLDisplay display, EGLenum type, guest_layout<const GuestEGLAttrib*> attributes) {
+  auto native = HostAttributes(attributes);
+  return fexldr_ptr_libEGL_eglCreateSync(display, type, native.empty() ? nullptr : native.data());
+}
+
+EGLImage fexfn_impl_libEGL_eglCreateImage(EGLDisplay display, EGLContext context, EGLenum target,
+                                       EGLClientBuffer buffer, guest_layout<const GuestEGLAttrib*> attributes) {
+  auto native = HostAttributes(attributes);
+  return fexldr_ptr_libEGL_eglCreateImage(display, context, target, buffer, native.empty() ? nullptr : native.data());
+}
+
+EGLDisplay fexfn_impl_libEGL_eglGetPlatformDisplay(EGLenum platform, void* display, guest_layout<const GuestEGLAttrib*> attributes) {
+  auto native = HostAttributes(attributes);
+  return fexldr_ptr_libEGL_eglGetPlatformDisplay(platform, display, native.empty() ? nullptr : native.data());
+}
+
+EGLSurface fexfn_impl_libEGL_eglCreatePlatformWindowSurface(EGLDisplay display, EGLConfig config, void* window,
+                                                         guest_layout<const GuestEGLAttrib*> attributes) {
+  auto native = HostAttributes(attributes);
+  return fexldr_ptr_libEGL_eglCreatePlatformWindowSurface(display, config, window, native.empty() ? nullptr : native.data());
+}
+
+EGLSurface fexfn_impl_libEGL_eglCreatePlatformPixmapSurface(EGLDisplay display, EGLConfig config, void* pixmap,
+                                                         guest_layout<const GuestEGLAttrib*> attributes) {
+  auto native = HostAttributes(attributes);
+  return fexldr_ptr_libEGL_eglCreatePlatformPixmapSurface(display, config, pixmap, native.empty() ? nullptr : native.data());
+}
+
+EGLBoolean fexfn_impl_libEGL_eglGetSyncAttrib(EGLDisplay display, EGLSync sync, EGLint attribute,
+                                            guest_layout<GuestEGLAttrib*> value) {
+  EGLAttrib native;
+  auto result = fexldr_ptr_libEGL_eglGetSyncAttrib(display, sync, attribute, value.data ? &native : nullptr);
+  if (result && value.data) {
+    value.get_pointer()->data = native;
+  }
+  return result;
+}
