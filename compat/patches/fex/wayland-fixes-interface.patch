+// Intrusive lists and arrays belong to guest memory. Implement the utility
+// functions here so pointer fields and size_t retain the guest ABI.
+extern "C" void wl_list_init(wl_list* list) {
+  list->prev = list->next = list;
+}
+extern "C" void wl_list_insert(wl_list* list, wl_list* elm) {
+  elm->prev = list;
+  elm->next = list->next;
+  list->next->prev = elm;
+  list->next = elm;
+}
+extern "C" void wl_list_remove(wl_list* elm) {
+  elm->prev->next = elm->next;
+  elm->next->prev = elm->prev;
+  elm->prev = elm->next = nullptr;
+}
+extern "C" int wl_list_empty(const wl_list* list) {
+  return list->next == list;
+}
+extern "C" int wl_list_length(const wl_list* list) {
+  int count = 0;
+  for (auto* elm = list->next; elm != list; elm = elm->next) ++count;
+  return count;
+}
+extern "C" void wl_list_insert_list(wl_list* list, wl_list* other) {
+  if (wl_list_empty(other)) return;
+  other->next->prev = list;
+  other->prev->next = list->next;
+  list->next->prev = other->prev;
+  list->next = other->next;
+}
+extern "C" void wl_array_init(wl_array* array) {
+  *array = {};
+}
+extern "C" void wl_array_release(wl_array* array) {
+  free(array->data);
+}
+extern "C" void* wl_array_add(wl_array* array, size_t size) {
+  if (size > SIZE_MAX - array->size) return nullptr;
+  const size_t required = array->size + size;
+  if (required > array->alloc) {
+    size_t capacity = std::max(array->alloc, size_t{16});
+    while (capacity < required) {
+      if (capacity > SIZE_MAX / 2) { capacity = required; break; }
+      capacity *= 2;
+    }
+    auto* data = realloc(array->data, capacity);
+    if (!data) return nullptr;
+    array->data = data;
+    array->alloc = capacity;
+  }
+  auto* result = static_cast<char*>(array->data) + array->size;
+  array->size = required;
+  return result;
+}
+extern "C" int wl_array_copy(wl_array* array, wl_array* source) {
+  if (array == source) return 0;
+  if (source->size > array->size && !wl_array_add(array, source->size - array->size)) return -1;
+  if (source->size) memcpy(array->data, source->data, source->size);
+  array->size = source->size;
+  return 0;
+}
