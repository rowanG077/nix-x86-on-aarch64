+#ifdef IS_32BIT_THUNK
+static guest_layout<wl_message>* AllocateGuestMessages(size_t count) {
+  if (count == 0) {
+    return nullptr;
+  }
+
+  // malloc/new may reuse arenas allocated above 4 GiB before FEX enabled its
+  // 32-bit address-space restrictions. These arrays are dereferenced by the
+  // guest, so request a fresh mapping instead of truncating a heap pointer.
+  // Like the interface symbols they accompany, the arrays live until exit.
+  const size_t bytes = count * sizeof(guest_layout<wl_message>);
+  void* allocation = mmap(nullptr, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (allocation == MAP_FAILED || reinterpret_cast<uintptr_t>(allocation) > UINT32_MAX - (bytes - 1)) {
+    if (allocation != MAP_FAILED) {
+      munmap(allocation, bytes);
+    }
+    fprintf(stderr, "Failed to allocate Wayland interface data in the 32-bit guest address space\n");
+    std::abort();
+  }
+  return static_cast<guest_layout<wl_message>*>(allocation);
+}
+#endif
